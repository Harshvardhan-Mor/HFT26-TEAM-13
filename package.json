  "description": "Open-source interactive 3D explorer for NASA Exoplanet Archive data, with habitability indicators and an AI virtual astronomer.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "fetch-data": "node scripts/fetch-nasa.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js"
